{
  "manifest_version": 3,
  "name": "Linkiving Extension",
  "version": "0.1.0",
  "description": "Linkiving popup for quickly saving links.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Linkiving",
    "default_popup": "unsupported-popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "activeTab", "cookies", "scripting", "storage"],
  "host_permissions": ["https://linkiving.com/*", "https://api.linkiving.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
