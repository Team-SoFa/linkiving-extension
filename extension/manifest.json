{
  "manifest_version": 3,
  "name": "Linkiving Extension",
  "version": "0.1.0",
  "description": "Linkiving popup for quickly saving links.",
  "action": {
    "default_title": "Linkiving",
    "default_popup": "unsupported-popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "activeTab", "cookies", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["linkiving-page-toast.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "next/*", "*.js", "*.css", "fonts/*", "images/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
