# Chrome extension build-time API base URL. Must be absolute, e.g. https://api.linkiving.com
NEXT_PUBLIC_EXTENSION_API_BASE_URL=

# Optional frontend/auth URL used to read the login cookie from the Linkiving site.
# Example: https://linkiving.com
NEXT_PUBLIC_EXTENSION_AUTH_BASE_URL=

# Optional token sent as Authorization: Bearer <token>.
# Do not place a privileged server secret here. Anything in NEXT_PUBLIC_* is exposed in the built extension.
NEXT_PUBLIC_EXTENSION_API_TOKEN=
