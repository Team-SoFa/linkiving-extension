# Chrome extension build-time API base URL. Must be absolute, e.g. https://api.linkiving.com
NEXT_PUBLIC_EXTENSION_API_BASE_URL=

# Optional frontend/auth URL used to read the login cookie from the Linkiving site.
# Example: https://linkiving.com
NEXT_PUBLIC_EXTENSION_AUTH_BASE_URL=

# Website opened by the login button. Defaults to https://linkiving.com.
# For local review, set this and the auth URL above to http://localhost:3000.
NEXT_PUBLIC_EXTENSION_APP_URL=

# Optional local-development fallback used only when NODE_ENV is not production.
# Never use a privileged or long-lived secret; NEXT_PUBLIC_* is included in client bundles.
NEXT_PUBLIC_EXTENSION_API_TOKEN=
